{
  "name": "fake-memory",
  "version": "0.0.1",
  "install": ["node \"${AIPB_ADAPTER_DIR}/fake-memory.mjs\" install"],
  "init": ["fakemem init"],
  "settings": {
    "hooks": {
      "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "fakemem inject", "timeout": 5 }] }]
    }
  },
  "settleMs": 0,
  "export": ["fakemem export"],
  "reset": ["fakemem reset"],
  "hiddenWords": ["fakemem"]
}
